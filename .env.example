# Neon PostgreSQL connection string.
# Get this from your Neon project dashboard: https://console.neon.tech
# Format: postgresql://<user>:<password>@<host>/<database>?sslmode=verify-full
DATABASE_URL=

# Secret used to sign/encrypt admin session cookies. Generate with:
#   openssl rand -base64 32
AUTH_SECRET=

# Public site URL, used for absolute URLs in SEO metadata, sitemaps, OG tags and
# team QR codes. Production MUST be https://leotechsolution.com.np (no trailing
# slash, no www) — every printed ID-card QR encodes {this}/team/{slug}.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudinary credentials for the Media Library (image uploads).
# Get these from your Cloudinary dashboard: https://console.cloudinary.com
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP settings for admin email notifications (new contact inquiries).
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, and an App Password
# (https://myaccount.google.com/apppasswords), not your normal password.
SMTP_HOST=
SMTP_PORT=465
# Optional: "true" for implicit TLS (port 465), "false" for STARTTLS (587). Defaults from the port.
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# Optional: sender shown on emails (defaults to SMTP_USER), e.g. "LeoTech Website <you@gmail.com>"
SMTP_FROM=
# Optional: where notifications go (defaults to SMTP_USER)
ADMIN_NOTIFY_EMAIL=

# Optional: owner admin login for `npm run admin:reset` (creates the admin or
# resets its password). Not read by the running app — remove ADMIN_PASSWORD after use.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional: Google Search Console HTML-tag verification token (just the content
# value). Not needed if you verify the Domain property through DNS (recommended).
GOOGLE_SITE_VERIFICATION=
