# Neon PostgreSQL connection string.
# Get this from your Neon project dashboard: https://console.neon.tech
# Format: postgresql://<user>:<password>@<host>/<database>?sslmode=require
DATABASE_URL=

# Secret used to sign/encrypt admin session cookies. Generate with:
#   openssl rand -base64 32
AUTH_SECRET=

# Public site URL, used for absolute URLs in SEO metadata, sitemaps, and OG tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudinary credentials for the Media Library (image uploads).
# Get these from your Cloudinary dashboard: https://console.cloudinary.com
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP settings for admin email notifications (new contact inquiries).
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, and an App Password
# (https://myaccount.google.com/apppasswords), not your normal password.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Optional: sender shown on emails (defaults to SMTP_USER), e.g. "LeoTech Website <you@gmail.com>"
SMTP_FROM=
# Optional: where notifications go (defaults to SMTP_USER)
ADMIN_NOTIFY_EMAIL=
